{
  "name": "pagegraph",
  "version": "0.5.1",
  "description": "Route-declared SEO graph and audit toolkit for TanStack Start: sitemap/robots, React head, JSON-LD, Vite coverage gate, live audit, and Jev-backed link decisions.",
  "keywords": [
    "seo",
    "tanstack",
    "tanstack-start",
    "tanstack-router",
    "sitemap",
    "robots",
    "json-ld",
    "internal-links",
    "link-graph",
    "audit",
    "lighthouse",
    "vite",
    "jev"
  ],
  "homepage": "https://github.com/aryasaatvik/pagegraph#readme",
  "bugs": {
    "url": "https://github.com/aryasaatvik/pagegraph/issues"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/aryasaatvik/pagegraph.git"
  },
  "bin": {
    "pagegraph": "./dist/cli.js"
  },
  "files": [
    "dist",
    "package.json",
    "README.md",
    "LICENSE"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./react": {
      "types": "./dist/react.d.ts",
      "import": "./dist/react.js"
    },
    "./vite": {
      "types": "./dist/vite.d.ts",
      "import": "./dist/vite.js"
    },
    "./config": {
      "types": "./dist/config.d.ts",
      "import": "./dist/config.js"
    },
    "./audit": {
      "types": "./dist/audit.d.ts",
      "import": "./dist/audit.js"
    }
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org"
  },
  "scripts": {
    "build": "bunx tsdown",
    "prepare": "bun run build",
    "prepack": "bun run build",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "tegami": "bun tegami.config.mts",
    "version:packages": "bun run tegami version",
    "release:check": "bun run typecheck && bun run test && bun run release:validate",
    "release:validate": "bun run scripts/validate-release.ts",
    "release": "bun run release:check && bun run tegami publish"
  },
  "dependencies": {
    "@tanstack/router-generator": "^1.167.21"
  },
  "devDependencies": {
    "@effect/ai-typesafe": "4.0.0-rc.116",
    "@effect/platform-bun": "4.0.0-rc.116",
    "@effect/platform-node-shared": "4.0.0-rc.116",
    "@effect/vitest": "4.0.0-rc.116",
    "@tanstack/react-router": "^1.170.18",
    "@types/node": "^24.0.0",
    "@types/react": "19.2.18",
    "effect": "4.0.0-rc.116",
    "lighthouse": "13.4.1",
    "react": "19.2.8",
    "schema-dts": "^2.0.0",
    "tegami": "1.4.0",
    "tsdown": "^0.22.13",
    "typescript": "^6.0.3",
    "vite": "~8.2.0",
    "vitest": "^5.0.0"
  },
  "peerDependencies": {
    "@effect/ai-typesafe": "^4.0.0-rc.116",
    "@effect/platform-bun": "^4.0.0-rc.116",
    "@tanstack/react-router": "^1.170.0",
    "effect": "^4.0.0-rc.116",
    "lighthouse": ">=13.0.0",
    "react": "^19.0.0",
    "vite": "^8.0.0"
  },
  "peerDependenciesMeta": {
    "@effect/ai-typesafe": {
      "optional": true
    },
    "@effect/platform-bun": {
      "optional": true
    },
    "effect": {
      "optional": true
    },
    "lighthouse": {
      "optional": true
    },
    "react": {
      "optional": true
    },
    "vite": {
      "optional": true
    }
  }
}
